  ["eval", "(()=>{const m=document.querySelector('[data-screen-label=\"Settings\"]');const r=m.getBoundingClientRect();const nav=m.querySelector('nav');const nr=nav.getBoundingClientRect();const h=m.querySelector('header');const hr=h.getBoundingClientRect();const sc=[...m.children[1].children].find(c=>c.style.overflow==='auto')||m.children[1].children[1];const t=m.querySelector('header span');const navBtns=[...nav.querySelectorAll('button')].map(b=>{const q=b.getBoundingClientRect();return [b.textContent.trim().slice(0,24),Math.round(q.x),Math.round(q.y+window.scrollY),Math.round(q.width),Math.round(q.height)];});return {modal:{x:r.x,y:r.y,w:r.width,h:r.height},nav:{x:nr.x,y:nr.y,w:nr.width,h:nr.height,padding:getComputedStyle(nav).padding,bg:getComputedStyle(nav).backgroundColor},header:{h:hr.height,padding:getComputedStyle(h).padding,borderBottom:getComputedStyle(h).borderBottomColor},body:{padding:getComputedStyle(sc).padding,gap:getComputedStyle(sc).gap,clientH:sc.clientHeight,scrollH:sc.scrollHeight},titleSize:getComputedStyle(t).fontSize,titleFont:getComputedStyle(t).fontFamily,titleText:t.textContent,navBtns:navBtns};})()", 4000],
